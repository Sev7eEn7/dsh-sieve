{
  "name": "dsh-sieve",
  "version": "0.3.0",
  "description": "Context engineering and token optimization plugin for DeepSeek Harness (DSH): tool output filtering, context pruning and progressive skill disclosure for LLM coding agents",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "context-engineering",
    "context-management",
    "context-pruning",
    "context-window",
    "token-optimization",
    "token-efficiency",
    "prompt-compression",
    "llm",
    "llm-agent",
    "coding-agent",
    "ai-agent",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sev7eEn7/dsh-sieve.git",
    "directory": "packages/dsh-sieve"
  },
  "homepage": "https://github.com/Sev7eEn7/dsh-sieve#readme",
  "bugs": {
    "url": "https://github.com/Sev7eEn7/dsh-sieve/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./status": {
      "types": "./lib/types/status.d.ts",
      "default": "./lib/status.js"
    },
    "./measurement": {
      "types": "./lib/types/measurement/probe.d.ts",
      "default": "./lib/measurement/probe.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
